// DERIVATION (N-I).
//   C site    : analyze wit_44
//   Statement : solver_analyze_which_implies_wit_44, a single entailment with
//               one hypothesis binder, `PreH1 : solver_shape
//               Mclear` -- which is exactly what the `check` reproduces.
//   Seven left atoms: the widest pattern in the file (rule 46 has six).
//   The obligation is provable and its proof needs a
//   `prop_apply_p (PtrArray.seg_Zlength ...)` + `unfold solver_shape` + `lia`
//   bridge to learn `n = ms_size M`.  The wit is engine-discharged in
//   solver_qcp_proof_auto.v, which is what this rule achieves.
// SCOPING.
//   (a) `solver_rep_analyze_at` occurs in ZERO Require/Ensure (25 occurrences:
//       6 which-implies RHS, 10 standalone assertions, 5 of them spelled
//       `Assert`, and 9 LHS).  CLEAN.
//   (b) none.
//   (c) **ENGAGED -- AT-RISK.**  `check : infer(solver_shape(M))` is a
//       conditional rule.  `infer` is semantic LIA; `solver_shape` is an
//       Extern Coq `Prop` and is opaque to it, so the check can only succeed by
//       the engine finding the prop in the block's PROP list.  At the target
//       site it is there literally (`solver_shape(Mclear)`).  At the
//       other fifteen `solver_rep_analyze_at` goal positions the left pattern's
//       seven atoms are not simultaneously present, so the rule should not fire
//       there -- but a half-firing conditional rule is the documented way to
//       make `goal.v` LARGER.  If goal.v grows, revert THIS rule first.
//   U = 16 goal positions (6 wi RHS + 10 standalone assertions), W = 1,
//   I = 1, `W \ I` = 0.
// OBLIGATION: solver_qcp_strategy56, PROVED to Qed.

// V2.1.0 emits array-cell addresses as `pointer_offset(p, i, T)`, while the
// shared read-only PtrArray refold rule recognizes only `p + i * sizeof(PTR)`.
// Reclose an explicitly focused pointer cell when base and index are provably
// equal; this is the pointer-offset analogue of the shared PtrArray rule.
// `solver_propagate`'s watcher scan is where that shape arises: it opens
// `PtrArray::missing_i(begin, ii, 0, Zlength(source_words), ...)` around a slot
// spelled with `pointer_offset`.
id : 58
priority : post(1)
left : PtrArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, PTR), PTR, l[i - lo]) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(PtrArray::seg(p, lo, hi, l));

// V2.1.0 emits signed-byte accesses with `pointer_offset`, while the shared
// CharArray read-only refold rule recognizes only `p + i * sizeof(I8)`.
id : 57
priority : post(1)
left : CharArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I8), I8, l[i - lo]) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(CharArray::seg(p, lo, hi, l));

// Updating signed-byte counterpart; preserves the exact list update performed
// by the shared arithmetic-address CharArray rule.
id : 59
priority : post(4)
left : CharArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I8), I8, ?v) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(CharArray::seg(
           p, lo, hi, replace_Znth{Z}(i - lo, v, l)));

// A local assigned from `veci_begin` is read back through a fresh symbolic
// temporary in V2.1.0.  The returned pointer equality is explicit, so cancel
// otherwise identical integer segments under that proved base equality.
id : 60
priority : core(1)
left : IntArray::seg(?p, ?lo, ?hi, ?l) at 0
right : IntArray::seg(?q, lo, hi, l) at 1
check : infer(p == q);
action : left_erase(0);
         right_erase(1);

// Sort's marked result fixes the current list, while repeated getters return
// distinct symbolic base and length values. Cancel the same list segment only
// after checking equality of the independently matched base and both bounds.
id : 68
priority : core(1)
left : PtrArray::seg(?p, ?lo, ?hi, ?l) at 0
right : PtrArray::seg(?q, ?lo2, ?hi2, l) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);

// V2.1.0 may refold two read-only uses of the same pointer-array cell as two
// nested writes of its existing value.  Normalize that exact shape only when
// the goal asks for the original missing segment.
id : 61
priority : core(1)
left : PtrArray::missing_i(
         ?p, ?i, 0, ?n,
         replace_Znth{Z}(
           i, Znth{Z}(i, ?words, 0),
           replace_Znth{Z}(i, Znth{Z}(i, words, 0), words))) at 0
right : PtrArray::missing_i(p, i, 0, n, words) at 1
check : infer(0 <= i);
        infer(i < n);
action : left_erase(0);
         right_erase(1);

// [solver_setnvars] holds its nine field cells -- the qtail counter and the
// eight array base pointers -- and its sixteen array/watch-list atoms folded
// as setnvars_arrays_at at the three cuts that carry the bundle: the entry
// which-implies, the growth-loop invariant and the initialising-loop
// invariant.  Unfold it on the spatial left whenever one of those nine fields
// is demanded: the growth shims take the eight array base pointers as
// arguments -- the trail shim with s->qtail as its live-prefix bound -- and
// the first which-implies of the loop body names
// store(&(s->wlists), vecp *, wlc) on its left.  The invariant of the
// initialising loop folds the bundle again at every iteration head, so the rule
// fires once per iteration and the later cuts of that iteration see raw atoms.
// The size bound [sz] is re-emitted verbatim so the shared undef write rules
// (undef_uint_array id 13 and kin) see the loop counter.
// SCOPING: solver_setnvars only; the predicate occurs in no other function.
// ENV: every action symbol is declared in solver_qcp_def.h -- ms_cap, ms_core,
