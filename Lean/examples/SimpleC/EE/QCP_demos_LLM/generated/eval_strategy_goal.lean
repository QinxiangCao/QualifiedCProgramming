noncomputable def eval_strategy0 : Prop :=
  forall (p : Int) (l0 : expr),
    TT &&
    emp **
    ((store_expr p l0))
    |--
    (
    TT &&
    emp
    ) ** (
    ALL l1 : expr, 
(
      TT &&
      (“ (l0 = l1) ”) &&
      emp) -* (
      TT &&
      emp **
      ((store_expr p l1)))
      )

noncomputable def eval_strategy1 : Prop :=
  forall (p : Int) (l0 : expr) (q0 : Int),
    TT &&
    emp **
    ((store_expr_aux p q0 l0))
    |--
    (
    TT &&
    emp
    ) ** (
    ALL l1 : expr, ALL q1 : Int, 
(
      TT &&
      (“ (q0 = q1) ”) &&
      (“ (l0 = l1) ”) &&
      emp) -* (
      TT &&
      emp **
      ((store_expr_aux p q1 l1)))
      )

