         right_add(var_header_rep(v_data, values, reasons, levels));
         right_add(clause_header_rep(cl_data, states, true_counts,
           unassigned, row_table));
         right_add(unconstrained_Assignment(values, reasons, levels, n, snap));
         right_add(solver_arrays_rep(states, true_counts, unassigned,
           row_table, live, cap, snap));

