// Veci::rep_ptr on the left and a cell (indexed or the base) or segment of its buffer on the right: open it
// to its header, element segment and undefined tail.
id : 202
priority : core(2)
left : Veci::rep_ptr(?v, ?p, ?l) at 0
right : (store(?q + ?i * sizeof(I32), I32, ?y) ||
         undef_data_at(?q + ?i * sizeof(I32), I32) ||
         store(pointer_offset(?q, ?i, I32), I32, ?y) ||
         undef_data_at(pointer_offset(?q, ?i, I32), I32) ||
         IntArray::seg(?q, ?lo, ?hi, ?ll) ||
         IntArray::undef_seg(?q, ?lo, ?hi) ||
         store(?q, I32, ?y) ||
         undef_data_at(?q, I32)) at 1
check : infer(q == p);
action : left_erase(0);
         left_exist_add(cap);
         left_add(0 <= Zlength{Z}(l));
         left_add(Zlength{Z}(l) <= cap);
         left_add(cap <= INT_MAX());
         left_add(vec_buf_ok(cap, p));
         left_add(Veci::header(v, p, Zlength{Z}(l), cap));
         left_add(IntArray::seg(p, 0, Zlength{Z}(l), l));
         left_add(IntArray::undef_seg(p, Zlength{Z}(l), cap));

