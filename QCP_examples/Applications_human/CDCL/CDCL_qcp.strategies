/* --- clause_arrays_explicit_rep: unfold ONE layer at a time -----------------
   The bundle is now two layers (CDCL_qcp_lib.v): the summaries predicate and
   the row table.  Rules 23/24 peel exactly the outer layer, so they add TWO
   atoms; rules 29/30 below peel the summaries predicate into its six atoms.
   Composed, the pair reaches the same seven atoms the flat rules used to add.

   Keeping the layers separate is the point: an annotation that focuses one row
   holds `clause_summaries_explicit_rep ** installed_row_focus_rep ...`, which
   the flat bundle could not express -- it always claimed the whole row table
   as `IntPtrArray2::full`. */

id : 23
priority : core(1)
right : clause_arrays_explicit_rep(
          ?states, ?true_counts, ?unassigned, ?row_table, ?live, ?cap,
          ?rows, ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : right_erase(0);
         right_add(clause_summaries_explicit_rep(
           states, true_counts, unassigned, live, cap,
           cur_states, cur_true, cur_unassigned));
         right_add(installed_rows_capacity_rep(row_table, live, cap, rows));

id : 24
priority : core(1)
left : clause_arrays_explicit_rep(
         ?states, ?true_counts, ?unassigned, ?row_table, ?live, ?cap,
         ?rows, ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : left_erase(0);
         left_add(clause_summaries_explicit_rep(
           states, true_counts, unassigned, live, cap,
           cur_states, cur_true, cur_unassigned));
         left_add(installed_rows_capacity_rep(row_table, live, cap, rows));

id : 25
priority : core(1)
right : resolution_rows_rep(
          ?wi, ?wj, ?result_row, ?n, ?left_row, ?right_row) at 0
action : right_erase(0);
         right_add(IntArray::full(wi, n, left_row));
         right_add(IntArray::full(wj, n, right_row));
         right_add(IntArray::full(
           result_row, n, dense_cancel_union(left_row, right_row)));

id : 26
priority : core(1)
left : resolution_rows_rep(
         ?wi, ?wj, ?result_row, ?n, ?left_row, ?right_row) at 0
action : left_erase(0);
         left_add(IntArray::full(wi, n, left_row));
         left_add(IntArray::full(wj, n, right_row));
         left_add(IntArray::full(
           result_row, n, dense_cancel_union(left_row, right_row)));

id : 27
priority : core(1)
right : conflict_levels_rep(
          ?s, ?clause, ?n, ?v_data, ?levels, ?row, ?snap) at 0
action : right_erase(0);
         right_add(data_at(field_addr(s, sat_data, v_size), I32, n));
         right_add(data_at(field_addr(s, sat_data, v_data), PTR, v_data));
         right_add(data_at(field_addr(v_data, var_data, dl), PTR, levels));
         right_add(IntArray::full(clause, n, row));
         right_add(IntArray::full(levels, n, snap_levels(snap)));

