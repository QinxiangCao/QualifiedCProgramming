                           mt_lim(ms_core(M))));

// Expose progress inputs while preserving all cached backing pointers.
id : 49
priority : core(2)
right : solver_search_progress_frame_at(?s, ?M, ?asg, ?lvl, ?wl) at 0
left : solver_rep_assigns_levels_at(s, M, asg, lvl, wl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(s, solver_t, size), I32, ms_size(M)));
         left_add(store(field_addr(s, solver_t, assigns), PTR, asg));
         left_add(CharArray::seg(asg, 0, ms_size(M), mt_assigns(ms_core(M))));
         left_add(store(field_addr(s, solver_t, levels), PTR, lvl));
         left_add(IntArray::seg(lvl, 0, ms_size(M), mt_levels(ms_core(M))));
         left_add(store(field_addr(s, solver_t, progress_estimate), double, ms_progress(M)));

// Expose search initialization fields and retain the watcher-table address.
id : 50
priority : core(2)
right : solver_search_init_frame_at(?s, ?M, ?lvl, ?wl) at 0
left : solver_rep_levels_wl_at(s, M, wl, lvl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, starts),
                        U64, stats_starts(ms_stats(M))));
         left_add(store(field_addr(s, solver_t, var_decay), double, ms_var_decay(M)));
         left_add(store(field_addr(s, solver_t, cla_decay), float, ms_cla_decay(M)));
         left_add(Veci::rep(field_addr(s, solver_t, model), ms_model(M)));

// Expose the learnt vector and queue tail, retaining the watcher table.
id : 51
priority : core(2)
right : solver_search_reducedb_frame_at(?s, ?M, ?lvl, ?wl) at 0
left : solver_rep_levels_wl_at(s, M, wl, lvl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(s, solver_t, qtail), I32, ms_qtail(M)));
         left_add(Vecp::rep(field_addr(s, solver_t, learnts),
                           db_words(ms_learnt(M))));

// Rejoin the learnt vector and queue tail with the same watcher table.
id : 52
priority : core(2)
right : solver_rep_levels_wl_at(?s, ?M, ?wl, ?lvl) at 0
left : solver_search_reducedb_frame_at(s, M, lvl, wl) at 1
       store(field_addr(s, solver_t, qtail), I32, ms_qtail(M)) at 2
       Vecp::rep(field_addr(s, solver_t, learnts),
                db_words(ms_learnt(M))) at 3
action : right_erase(0);
         left_erase(3);
         left_erase(2);
         left_erase(1);

// Expose literal counters while preserving the analyzer backing pointers.
id : 53
priority : core(2)
right : solver_literal_stats_frame_at(?s, ?M, ?rsn, ?lvl, ?trl, ?tgs, ?wl) at 0
left : solver_rep_analyze_at(s, M, rsn, lvl, trl, tgs, wl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, max_literals),
                        U64, stats_max_literals(ms_stats(M))));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, tot_literals),
                        U64, stats_tot_literals(ms_stats(M))));

// Expose simplify bookkeeping and retain the cached watcher-table address.
id : 54
priority : core(2)
right : solver_simplify_finish_frame_at(?s, ?M, ?lvl, ?wl) at 0
left : solver_rep_reasons_levels_wl_at(s, M, ?rsn, lvl, wl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(s, solver_t, qhead), I32, mt_qhead(ms_core(M))));
         left_add(store(field_addr(s, solver_t, simpdb_assigns), I32, ms_simpdb_assigns(M)));
         left_add(store(field_addr(s, solver_t, simpdb_props), I32, ms_simpdb_props(M)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, clauses_literals),
                        U64, stats_clauses_literals(ms_stats(M))));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, learnts_literals),
                        U64, stats_learnts_literals(ms_stats(M))));

// Expose the assignment array and model vector, retaining the watcher table.
id : 55
priority : core(2)
right : solver_model_copy_frame_at(?s, ?M, ?lvl, ?wl) at 0
left : solver_rep_levels_wl_at(s, M, wl, lvl) at 1
action : right_erase(0);
         left_erase(1);
         left_exist_add(values_ptr);
         left_add(store(field_addr(s, solver_t, size), I32, ms_size(M)));
         left_add(store(field_addr(s, solver_t, assigns), PTR, values_ptr));
         left_add(CharArray::seg(values_ptr, 0, ms_size(M), mt_assigns(ms_core(M))));
         left_add(solver_char_tail(values_ptr, ms_size(M), ms_cap(M)));
         left_add(Veci::rep(field_addr(s, solver_t, model), ms_model(M)));

// `solver_shape` is an opaque Coq Prop, so the
// rule is gated to blocks whose pure list carries `solver_shape` literally
// and whose left side holds all seven atoms at once.
id : 56
priority : core(2)
right : solver_rep_analyze_at(?s, ?M, ?rsn, ?lvl, ?trl, ?tgs, ?wl) at 0
left : solver_reason_levels_frame_at(s, M, trl, tgs, wl) at 1
       store(field_addr(s, solver_t, reasons), PTR, rsn) at 2
       PtrArray::seg(rsn, 0, ?n, ms_reason_words(M)) at 3
       solver_ptr_tail(rsn, n, ms_cap(M)) at 4
       store(field_addr(s, solver_t, levels), PTR, lvl) at 5
       IntArray::seg(lvl, 0, n, mt_levels(ms_core(M))) at 6
       solver_int_tail(lvl, n, ms_cap(M)) at 7
check : infer(solver_shape(M));
action : right_erase(0);
         left_erase(7);
         left_erase(6);
         left_erase(5);
         left_erase(4);
         left_erase(3);
         left_erase(2);
         left_erase(1);

// The frontend emits array-cell addresses as `pointer_offset(p, i, T)`, while
// the shared read-only PtrArray refold rule recognizes only
// `p + i * sizeof(PTR)`.
// Reclose an explicitly focused pointer cell when base and index are provably
// equal; this is the pointer-offset analogue of the shared PtrArray rule.
id : 58
priority : post(1)
left : PtrArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, PTR), PTR, l[i - lo]) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(PtrArray::seg(p, lo, hi, l));

// The frontend emits signed-byte accesses with `pointer_offset`, while the
// shared CharArray read-only refold rule recognizes only
// `p + i * sizeof(I8)`.
id : 57
priority : post(1)
left : CharArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I8), I8, l[i - lo]) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(CharArray::seg(p, lo, hi, l));

// Updating signed-byte counterpart; preserves the exact list update performed
// by the shared arithmetic-address CharArray rule.
id : 59
priority : post(4)
left : CharArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I8), I8, ?v) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(CharArray::seg(
           p, lo, hi, replace_Znth{Z}(i - lo, v, l)));

// The frontend may refold two read-only uses of the same pointer-array cell
// as two nested writes of its existing value.  Normalize that exact shape
// only when the goal asks for the original missing segment.
id : 61
priority : core(1)
left : PtrArray::missing_i(
         ?p, ?i, 0, ?n,
         replace_Znth{Z}(
           i, Znth{Z}(i, ?words, 0),
           replace_Znth{Z}(i, Znth{Z}(i, words, 0), words))) at 0
right : PtrArray::missing_i(p, i, 0, n, words) at 1
check : infer(0 <= i);
        infer(i < n);
action : left_erase(0);
         right_erase(1);

id : 62
priority : core(2)
left : setnvars_arrays_at(?s, ?M, ?sz, ?wl, ?act, ?asg, ?opos,
                          ?rsn, ?lvl, ?trl, ?tgs) at 0
right : (store(field_addr(s, solver_t, qtail), I32, ?y) ||
         store(field_addr(s, solver_t, wlists), PTR, ?y) ||
         store(field_addr(s, solver_t, activity), PTR, ?y) ||
