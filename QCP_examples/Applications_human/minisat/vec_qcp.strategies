// A table of vectors VecpArray::full(b, n, ls) holds slot i at Vecp::slot(b, i) as a Vecp::rep with
// contents Znth(i, ls, nil).  A slot is named in three ways: Vecp::slot(b, i); an alias w with
// w == Vecp::slot(b, i), as returned by a getter; and the C address &b[i], which the frontend writes
// pointer_offset(b, i, struct vecp_t) and which equals Vecp::slot(b, i) (slot_eq).  Asking for one
// slot takes it out and leaves the table as VecpArray::missing_i; when the slot is back as a
// Vecp::rep the table refolds, with replace_Znth when its contents changed.

// VecpArray::full on the left and the rep of one of its slots on the right: take the slot out.
id : 401
priority : core(1)
left : VecpArray::full(?b, ?n, ?ls) at 0
right : Vecp::rep(Vecp::slot(b, ?i), ?l) at 1
check : infer(0 <= i);
        infer(i < n);
action : right_erase(1);
         left_erase(0);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         right_add(l == Znth{list{Z}}(i, ls, nil{Z}));

// VecpArray::full on the left and the buffer or a field of one of its slots on the right: take the
// slot out as its rep, for the vector rules to open.
id : 402
priority : core(1)
left : VecpArray::full(?b, ?n, ?ls) at 0
right : (Vecp::rep_ptr(Vecp::slot(b, ?i), ?p, ?l) ||
         store(field_addr(Vecp::slot(b, ?i), vecp_t, size), I32, ?y) ||
         store(field_addr(Vecp::slot(b, ?i), vecp_t, cap), I32, ?y) ||
         store(field_addr(Vecp::slot(b, ?i), vecp_t, ptr), PTR, ?y)) at 1
check : infer(0 <= i);
        infer(i < n);
action : left_erase(0);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         left_add(Vecp::rep(Vecp::slot(b, i), Znth{list{Z}}(i, ls, nil{Z})));

// 401 with the slot named by an alias.
id : 403
priority : core(1)
right : Vecp::rep(?w, ?l) at 0
left : ((w == Vecp::slot(?b, ?i)) || (Vecp::slot(?b, ?i) == w)) at 1
       VecpArray::full(b, ?n, ?ls) at 2
check : infer(0 <= i);
        infer(i < n);
action : right_erase(0);
         left_erase(2);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         right_add(l == Znth{list{Z}}(i, ls, nil{Z}));

// 402 with the slot named by an alias; the slot comes out under the alias.
id : 404
priority : core(1)
right : (Vecp::rep_ptr(?w, ?p, ?l) ||
         store(field_addr(?w, vecp_t, size), I32, ?y) ||
         store(field_addr(?w, vecp_t, cap), I32, ?y) ||
         store(field_addr(?w, vecp_t, ptr), PTR, ?y)) at 0
left : ((w == Vecp::slot(?b, ?i)) || (Vecp::slot(?b, ?i) == w)) at 1
       VecpArray::full(b, ?n, ?ls) at 2
check : infer(0 <= i);
        infer(i < n);
action : left_erase(2);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         left_add(Vecp::rep(w, Znth{list{Z}}(i, ls, nil{Z})));

// 401 with the slot named by its C address &b[i].
id : 405
priority : core(1)
left : VecpArray::full(?b, ?n, ?ls) at 0
right : Vecp::rep(pointer_offset(b, ?i, struct vecp_t), ?l) at 1
check : infer(0 <= i);
        infer(i < n);
action : right_erase(1);
         left_erase(0);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         right_add(l == Znth{list{Z}}(i, ls, nil{Z}));

// 402 with the slot named by its C address &b[i]; the slot comes out under that address.
id : 406
priority : core(1)
left : VecpArray::full(?b, ?n, ?ls) at 0
right : (Vecp::rep_ptr(pointer_offset(b, ?i, struct vecp_t), ?p, ?l) ||
         store(field_addr(pointer_offset(b, ?i, struct vecp_t), vecp_t, size), I32, ?y) ||
         store(field_addr(pointer_offset(b, ?i, struct vecp_t), vecp_t, cap), I32, ?y) ||
         store(field_addr(pointer_offset(b, ?i, struct vecp_t), vecp_t, ptr), PTR, ?y)) at 1
check : infer(0 <= i);
        infer(i < n);
action : left_erase(0);
         left_add(VecpArray::missing_i(b, i, 0, n, ls));
         left_add(Vecp::rep(pointer_offset(b, i, struct vecp_t), Znth{list{Z}}(i, ls, nil{Z})));

// VecpArray::full on the left and the table missing one slot on the right: take that slot out.
id : 407
priority : core(1)
left : VecpArray::full(?b, ?n, ?ls) at 0
right : VecpArray::missing_i(b, ?i, 0, ?m, ?ms) at 1
check : infer(m == n);
        infer(0 <= i);
        infer(i < n);
action : right_erase(1);
         left_erase(0);
         left_add(Vecp::rep(Vecp::slot(b, i), Znth{list{Z}}(i, ls, nil{Z})));
         right_add(ms == ls);

// VecpArray::full on both sides at the same base and a provably equal length: the contents are equal.
id : 408
priority : core(1)
left : VecpArray::full(?b, ?n, ?l1) at 0
right : VecpArray::full(b, ?m, ?l2) at 1
check : infer(m == n);
action : right_erase(1);
         left_erase(0);
         right_add(l1 == l2);

// VecpArray::missing_i on both sides at the same base and a provably equal slot and bounds: the
// contents are equal.
id : 409
priority : core(1)
left : VecpArray::missing_i(?b, ?i, ?lo, ?hi, ?l1) at 0
right : VecpArray::missing_i(b, ?j, ?lo2, ?hi2, ?l2) at 1
check : infer(j == i);
        infer(lo2 == lo);
        infer(hi2 == hi);
action : right_erase(1);
         left_erase(0);
         right_add(l1 == l2);

// The slot is back with its contents unchanged: refold the table.
id : 411
priority : post(1)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(Vecp::slot(b, i), Znth{list{Z}}(i, ls, nil{Z})) at 1
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, ls));

// The slot is back with contents l: refold the table with l at slot i.
id : 412
priority : post(3)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(Vecp::slot(b, i), ?l) at 1
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, replace_Znth{list{Z}}(i, l, ls)));

// 411 with the slot under an alias.
id : 413
priority : post(1)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(?w, Znth{list{Z}}(i, ls, nil{Z})) at 1
       ((w == Vecp::slot(b, i)) || (Vecp::slot(b, i) == w)) at 2
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, ls));

// 412 with the slot under an alias.
id : 414
priority : post(3)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(?w, ?l) at 1
       ((w == Vecp::slot(b, i)) || (Vecp::slot(b, i) == w)) at 2
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, replace_Znth{list{Z}}(i, l, ls)));

// 411 with the slot under its C address &b[i].
id : 415
priority : post(1)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(pointer_offset(b, i, struct vecp_t), Znth{list{Z}}(i, ls, nil{Z})) at 1
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, ls));

// 412 with the slot under its C address &b[i].
id : 416
priority : post(3)
left : VecpArray::missing_i(?b, ?i, 0, ?n, ?ls) at 0
       Vecp::rep(pointer_offset(b, i, struct vecp_t), ?l) at 1
action : left_erase(1);
         left_erase(0);
         left_add(VecpArray::full(b, n, replace_Znth{list{Z}}(i, l, ls)));

// IntArray::seg on both sides with the same bounds and contents and provably equal bases: cancel
// them.
id : 60
priority : core(1)
left : IntArray::seg(?p, ?lo, ?hi, ?l) at 0
right : IntArray::seg(?q, lo, hi, l) at 1
check : infer(p == q);
action : left_erase(0);
         right_erase(1);

// The PtrArray::seg twin, with the bounds also matched up to provable equality.
id : 68
priority : core(1)
left : PtrArray::seg(?p, ?lo, ?hi, ?l) at 0
right : PtrArray::seg(?q, ?lo2, ?hi2, l) at 1
check : infer(p == q);
        infer(lo == lo2);
        infer(hi == hi2);
action : left_erase(0);
         right_erase(1);
