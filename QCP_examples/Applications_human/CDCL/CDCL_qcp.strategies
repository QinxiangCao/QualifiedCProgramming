/* --- backtrack's focused-row wrapper (rules 77/78) -------------------------
   The same pure block as backtrack_inner_state (rules 75/76) -- the inner
   clause loop's stable facts, i.e. everything that mentions neither j nor
   the cleared cell -- plus one H1 instance keyed on current_snap at back_dl
   with row j focused.  The two variable-being-cleared facts, the focus
   bounds 0 <= j < live and the row-length bridge stay visible C conjuncts
   (ruling A4; section-2 H1 invariant): the wrapper must NOT contain them.

   Wrapper-above-head: 77/78 emit solver_row_focus_state, consumed by 73/74;
   every other emitted fact is a pure leaf. */

id : 77
priority : core(1)
right : backtrack_row_focus_state(?s, ?F, ?original_count, ?snap,
          ?conflict_snap, ?current_snap, ?after_snap, ?conflict_ranks,
          ?conflict_dl, ?back_dl, ?i, ?j, ?values, ?reasons, ?levels,
          ?states, ?true_counts, ?unassigned, ?row_table, ?n, ?live, ?cap,
          ?row_ptr, ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : right_erase(0);
         right_add(0 <= i);
         right_add(i < n);
         right_add(0 <= back_dl);
         right_add(back_dl < conflict_dl);
         right_add(0 <= n);
         right_add(n < INT_MAX());
         right_add(0 <= original_count);
         right_add(original_count <= live);
         right_add(0 <= live);
         right_add(live <= cap);
         right_add(coherent_snapshot(F, n, live, original_count, snap));
         right_add(stable_search_facts(n, conflict_snap, conflict_ranks,
           conflict_dl));
         right_add(snapshot_lengths(n, live, current_snap));
         right_add(snapshot_cells_wf(n, live, current_snap));
         right_add(snapshot_lengths(n, live, after_snap));
         right_add(snapshot_cells_wf(n, live, after_snap));
         right_add(snap_values(after_snap) ==
           replace_Znth{Z}(i, -1, snap_values(current_snap)));
         right_add(snap_reasons(after_snap) ==
           replace_Znth{Z}(i, -1, snap_reasons(current_snap)));
         right_add(snap_levels(after_snap) ==
           replace_Znth{Z}(i, -1, snap_levels(current_snap)));
         right_add(snap_rows(after_snap) == snap_rows(current_snap));
         right_add(snap_rows(current_snap) == snap_rows(snap));
         right_add(solver_row_focus_state(s, values, reasons, levels,
           states, true_counts, unassigned, row_table, n, live, cap,
           back_dl, j, row_ptr, snap_values(current_snap),
           snap_reasons(current_snap), snap_levels(current_snap),
           snap_rows(current_snap), cur_states, cur_true, cur_unassigned));

