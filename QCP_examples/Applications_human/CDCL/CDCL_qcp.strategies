#include "CDCL_qcp_def.h"

id : 3
priority : core(1)
left : installed_rows_capacity_rep(?p, ?live, ?cap, ?rows) at 0
right : data_at(p + (?i * sizeof(PTR)), PTR, ?v) at 1
check : infer(0 <= i);
        infer(i < live);
action : right_erase(1);
         left_erase(0);
         left_exist_add(row_ptr);
         left_add(IntPtrArray2::missing_i(p, live, i, row_ptr, rows));
         left_add(IntArray::full(row_ptr, Zlength{Z}(rows[i]), rows[i]));
         left_add(PtrArray::undef_seg(p, live, cap));
         right_add(v == row_ptr);

id : 4
priority : post(1)
left : IntPtrArray2::missing_i(?p, ?live, ?i, ?row_ptr, ?rows) at 0
       IntArray::full(row_ptr, Zlength{Z}(rows[i]), rows[i]) at 1
       data_at(p + (i * sizeof(PTR)), PTR, row_ptr) at 2
       PtrArray::undef_seg(p, live, ?cap) at 3
check : infer(0 <= i);
        infer(i < live);
action : left_erase(3);
         left_erase(2);
         left_erase(1);
         left_erase(0);
         left_add(installed_rows_capacity_rep(p, live, cap, rows));

