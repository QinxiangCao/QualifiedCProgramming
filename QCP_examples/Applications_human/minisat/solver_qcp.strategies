         store(field_addr(s, solver_t, trail), PTR, ?y) ||
         store(field_addr(s, solver_t, tags), PTR, ?y)) at 1
action : left_erase(0);
         left_add(store(field_addr(s, solver_t, qtail), I32, ms_qtail(M)));
         left_add(store(field_addr(s, solver_t, wlists), PTR, wl));
         left_add(store(field_addr(s, solver_t, activity), PTR, act));
         left_add(store(field_addr(s, solver_t, assigns), PTR, asg));
         left_add(store(field_addr(s, solver_t, orderpos), PTR, opos));
