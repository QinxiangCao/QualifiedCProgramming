// Vecp::rep of a table slot on the right, and the same slot held under an alias on the left.
id : 116
priority : core(2)
right : Vecp::rep(Vecp::slot(?base, ?j), ?l) at 0
left : Vecp::rep(?w, ?k) at 1
       ((w == Vecp::slot(base, ?i)) || (Vecp::slot(base, ?i) == w)) at 2
check : infer(i == j);
action : right_erase(0);
         left_erase(1);
         right_add(k == l);

// Vecp::rep of a table slot on the right and the slot opened under an alias on the left: close it.
id : 95
priority : core(2)
right : Vecp::rep(Vecp::slot(?base, ?index), ?l) at 0
left : ((?read_index == index) || (index == ?read_index)) at 1
       ((?requested == Vecp::slot(base, read_index)) ||
        (Vecp::slot(base, read_index) == ?requested)) at 2
       Vecp::header(requested, ?q, ?n, ?cap) at 3
action : right_erase(0);
         left_erase(3);
         right_add(n == Zlength{Z}(l));
         right_add(0 <= Zlength{Z}(l));
         right_add(Zlength{Z}(l) <= cap);
         right_add(cap <= INT_MAX());
         right_add(vec_buf_ok(cap, q));
         right_add(PtrArray::seg(q, 0, Zlength{Z}(l), l));
         right_add(PtrArray::undef_seg(q, Zlength{Z}(l), cap));

