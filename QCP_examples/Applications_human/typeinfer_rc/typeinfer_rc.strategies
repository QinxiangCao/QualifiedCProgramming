// Call-post transport is independent of a right-hand target. The owned world
// selects the current destination, so historical preserves edges cannot move
// facts back to a stale world. Retain old pure facts and transition history.
// absense is a syntactic saturation guard, not a mathematical premise: each
// existing (pointer, payload) pair is added at most once per destination map.
// This also makes reflexive transitions and cycles terminate without aliases
// being declared distinct. No count, capacity, solution or world is rewritten.
id : 36
priority : post(1)
left : rc_preserves(?M, ?N) at 0
       store_type(M, ?p : Z, ?tr) at 1
       store_world(N) at 2
check : absense(store_type(N, p, tr));
action : left_add(store_type(N, p, tr));

id : 37
priority : post(1)
left : rc_preserves(?M, ?N) at 0
       node_at(M, ?p : Z, ?n) at 1
       store_world(N) at 2
check : absense(node_at(N, p, n));
action : left_add(node_at(N, p, n));

