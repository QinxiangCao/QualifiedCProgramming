# Part 1: C inputs consumed by QCP symbolic execution.
CODEFORCES_C_FILES = \
	$(addprefix $(CODEFORCES_C_DIR)/,$(addsuffix .c,$(CODEFORCES_CASES)))

# Part 2: hand-maintained Rocq pre/post libraries.
CODEFORCES_LIB_FILES = \
	$(addprefix $(CODEFORCES_ROCQ_DIR)/,$(addsuffix _lib.v,$(CODEFORCES_CASES)))

# Part 3: Rocq files generated by the QCP symbolic-execution binary.
CODEFORCES_GENERATED_SUFFIXES = \
	_goal.v \
	_proof_auto.v \
	_proof_manual.v \
	_goal_check.v

CODEFORCES_GENERATED_FILES = \
	$(foreach case,$(CODEFORCES_CASES),\
		$(addprefix $(CODEFORCES_ROCQ_DIR)/$(case),$(CODEFORCES_GENERATED_SUFFIXES)))

# A large manual may be split into independent _proof_manual_partN.v files that
# the manual itself re-exports.  These are discovered rather than listed, so a
# case can be split or unsplit without editing this makefile.
CODEFORCES_MANUAL_PART_FILES = \
	$(foreach case,$(CODEFORCES_CASES),\
		$(wildcard $(CODEFORCES_ROCQ_DIR)/$(case)_proof_manual_part*.v))

# Part 4: shared Codeforces Rocq definitions used by case libraries.
CODEFORCES_CORE_DEP_FILES = \
	GraphLib/reachable/reachable_restricted.v \
	GraphLib/directed/rootedtree.v \
	SumLib/ZRect.v

CODEFORCES_HELPER_FILES = \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/SpecHelpers.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/array2_ext_lib.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/GraphInstances.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/GraphDistanceZ.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/ForwardStarZ.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/RootedTreeInstances.v \
	$(CODEFORCES_LOGICAL_HELPER_DIR)/RootedTreeDistance.v

# Shared array strategies imported by generated goals.  char_array serves the
# shard09 P002 and P020 goals; array2 and int_array additionally serve the
# two-dimensional cases (shard09 P009).
CODEFORCES_SHARED_STRATEGY_FILES = \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/char_array_strategy_goal.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/char_array_strategy_proof.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/int_array_strategy_goal.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/int_array_strategy_proof.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/array2_strategy_goal.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/array2_strategy_proof.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/ptr_array2_strategy_goal.v \
	$(CODEFORCES_SHARED_STRATEGY_DIR)/ptr_array2_strategy_proof.v

# Strategies owned by this bench: the char 2D rules and the array2_ext rules
# that cover the mixed/undef 2D axis.  goal_check is built too, so a broken
# soundness proof fails this makefile rather than passing silently.
CODEFORCES_LOCAL_STRATEGY_FILES = \
	$(CODEFORCES_ROCQ_DIR)/array2_char_strategy_goal.v \
	$(CODEFORCES_ROCQ_DIR)/array2_char_strategy_proof.v \
	$(CODEFORCES_ROCQ_DIR)/array2_char_strategy_goal_check.v \
	$(CODEFORCES_ROCQ_DIR)/array2_ext_strategy_goal.v \
	$(CODEFORCES_ROCQ_DIR)/array2_ext_strategy_proof.v \
	$(CODEFORCES_ROCQ_DIR)/array2_ext_strategy_goal_check.v

CODEFORCES_ROCQ_FILES = \
	$(CODEFORCES_CORE_DEP_FILES) \
	$(CODEFORCES_HELPER_FILES) \
	$(CODEFORCES_SHARED_STRATEGY_FILES) \
	$(CODEFORCES_LOCAL_STRATEGY_FILES) \
	$(CODEFORCES_LIB_FILES) \
	$(CODEFORCES_MANUAL_PART_FILES) \
	$(CODEFORCES_GENERATED_FILES)

# Builds and dependency generation can run before every expected library or
# symexec output exists.  Re-evaluating wildcard when make starts
# automatically picks up newly generated files on the next invocation.
CODEFORCES_PRESENT_CORE_DEP_FILES = $(wildcard $(CODEFORCES_CORE_DEP_FILES))
CODEFORCES_PRESENT_HELPER_FILES = $(wildcard $(CODEFORCES_HELPER_FILES))
CODEFORCES_PRESENT_SHARED_STRATEGY_FILES = $(wildcard $(CODEFORCES_SHARED_STRATEGY_FILES))
CODEFORCES_PRESENT_LOCAL_STRATEGY_FILES = $(wildcard $(CODEFORCES_LOCAL_STRATEGY_FILES))
CODEFORCES_PRESENT_LIB_FILES = $(wildcard $(CODEFORCES_LIB_FILES))
CODEFORCES_PRESENT_GENERATED_FILES = $(wildcard $(CODEFORCES_GENERATED_FILES))

CODEFORCES_PRESENT_ROCQ_FILES = \
	$(CODEFORCES_PRESENT_CORE_DEP_FILES) \
	$(CODEFORCES_PRESENT_HELPER_FILES) \
	$(CODEFORCES_PRESENT_SHARED_STRATEGY_FILES) \
	$(CODEFORCES_PRESENT_LOCAL_STRATEGY_FILES) \
	$(CODEFORCES_PRESENT_LIB_FILES) \
	$(CODEFORCES_MANUAL_PART_FILES) \
	$(CODEFORCES_PRESENT_GENERATED_FILES)

CODEFORCES_ROCQ_OUTPUTS = \
	$(CODEFORCES_ROCQ_FILES:%.v=%.glob) \
	$(CODEFORCES_ROCQ_FILES:%.v=%.vo) \
	$(CODEFORCES_ROCQ_FILES:%.v=%.vok) \
	$(CODEFORCES_ROCQ_FILES:%.v=%.vos)

CODEFORCES_AUX_OUTPUTS = \
	$(foreach file,$(CODEFORCES_ROCQ_FILES),\
		$(dir $(file)).$(notdir $(basename $(file))).aux)

CODEFORCES_DEPEND = .depend.codeforces
CODEFORCES_DEPEND_TMP = .depend.codeforces.tmp
CODEFORCES_DEPEND_ARGS = .coqdep.codeforces.args.tmp

$(CODEFORCES_ROCQ_FILES:%.v=%.vo): %.vo: %.v
ifeq ($(TIMING),)
	@printf "%s\n" "COQC $<"
	@$(COQC) $(COQ_FLAG) $(CURRENT_DIR)/$<
else
	@printf "%-70s" "COQC $<"; \
	t0=`date +%s`; \
	$(COQC) $(COQ_FLAG) $(CURRENT_DIR)/$<; \
	t1=`date +%s`; \
	echo "$$((t1 - t0)) s"
endif

all: codeforces

codeforces: \
	codeforces-c-files \
	$(CODEFORCES_PRESENT_ROCQ_FILES:%.v=%.vo)
	@:

codeforces-c-files: $(CODEFORCES_C_FILES)

codeforces-helpers: \
	$(CODEFORCES_PRESENT_CORE_DEP_FILES:%.v=%.vo) \
	$(CODEFORCES_PRESENT_HELPER_FILES:%.v=%.vo)

codeforces-strategies: \
	$(CODEFORCES_PRESENT_SHARED_STRATEGY_FILES:%.v=%.vo) \
	$(CODEFORCES_PRESENT_LOCAL_STRATEGY_FILES:%.v=%.vo)

codeforces-libs: $(CODEFORCES_PRESENT_LIB_FILES:%.v=%.vo)

codeforces-generated: $(CODEFORCES_PRESENT_GENERATED_FILES:%.v=%.vo)

$(CODEFORCES_DEPEND): Makefile.codeforces $(CODEFORCES_PRESENT_ROCQ_FILES)
	@printf '%s\n' '$(DEP_FLAG) $(CODEFORCES_PRESENT_ROCQ_FILES)' > $(CODEFORCES_DEPEND_ARGS)
	@$(COQDEP) -f $(CODEFORCES_DEPEND_ARGS) > $(CODEFORCES_DEPEND_TMP)
	@mv -f $(CODEFORCES_DEPEND_TMP) $(CODEFORCES_DEPEND)
	@rm -f $(CODEFORCES_DEPEND_ARGS)

depend-codeforces: $(CODEFORCES_DEPEND)

clean-codeforces:
	@rm -f \
		$(CODEFORCES_ROCQ_OUTPUTS) \
		$(CODEFORCES_AUX_OUTPUTS) \
		$(CODEFORCES_DEPEND) \
		$(CODEFORCES_DEPEND_TMP) \
		$(CODEFORCES_DEPEND_ARGS)

clean: clean-codeforces

.PHONY: \
	all \
	codeforces \
	codeforces-c-files \
	codeforces-helpers \
	codeforces-strategies \
	codeforces-libs \
	codeforces-generated \
	depend-codeforces \
	clean-codeforces \
	clean

.DEFAULT_GOAL := codeforces

ifeq ($(filter clean clean-codeforces,$(MAKECMDGOALS)),)
-include $(CODEFORCES_DEPEND)
endif
