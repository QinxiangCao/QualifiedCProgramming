#include "typeinfer_rc.h"

// Demand-driven missing-list lookup. Function contracts and C are unchanged.
// field_lookup(p,s,L) := True is a search-control tag, NOT a freshness certificate.
// Only a real left-hand field_fresh(field_key(p,s),L) permits extraction/merge.
// IDs 54-105 perform demand-driven lookup, bottom-up proof, and cleanup.


// The integer solver need not perform the finite tag case split itself.
id : 53
priority : core(9)
left : store_world_missing(?M, ?L) at 0
       node_at(M, ?p : Z, ?n) at 1
       rc_valid(M) at 3
       field_fresh(field_key(p, Payload0()), L) at 10
right : store(field_addr(field_addr(field_addr(p, atype, d), anonymous(atype.d), ATOM), anonymous(atype.d.ATOM), name), I32, ?v) at 2
check : infer(node_tag(n) != 1);
        infer(node_tag(n) != 2);
        infer(node_tag(n) != 3);
action : left_add(node_tag(n) == 0);
         right_add(v == node_a(n));
         left_erase(0);
         right_erase(2);
         left_add(store_world_missing(M, cons{TypeFieldKey}(field_key(p, Payload0()), L)));

// Expose the two child interpretations only while servicing a child read.
id : 44
priority : core(7)
left : store_type(?M, ?p : Z, ?tr) at 0
       node_at(M, p, ?n) at 1
       store_world_missing(M, ?L) at 2
       field_fresh(field_key(p, Payload0()), L) at 10
right : store(field_addr(field_addr(field_addr(p, atype, d), anonymous(atype.d), ARROW), anonymous(atype.d.ARROW), from), PTR, ?v) at 3
check : infer(node_tag(n) == 1);
action : left_exist_add(a : <TypeTree>);
         left_exist_add(b : <TypeTree>);
         left_add(tr == TArrow(a, b));
         left_add(store_type(M, node_a(n), a));
         left_add(store_type(M, node_b(n), b));
         right_add(v == node_a(n));
         left_erase(2);
         right_erase(3);
         left_add(store_world_missing(M, cons{TypeFieldKey}(field_key(p, Payload0()), L)));

