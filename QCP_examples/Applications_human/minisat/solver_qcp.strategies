// The watch table on the left and one of its vectors, at a slot provably in range, on the right:
// expose the table's body, a VecpArray::full of 2n vectors, for the vector rules to take the vector
// out.
id : 93
priority : core(1)
left : wlists_rep(?b, ?n, ?wm) at 0
right : (Vecp::rep(Vecp::slot(b, ?i), ?l) ||
         Vecp::rep_ptr(Vecp::slot(b, ?i), ?p, ?l)) at 1
check : infer(0 <= i);
        infer(i < 2 * n);
action : left_erase(0);
         left_add(Zlength{list{Z}}(wm) == 2 * n);
         left_add(VecpArray::full(b, 2 * n, wm));

// 93 with the vector named by an alias of its slot, as solver_read_wlist returns it.
id : 94
priority : core(1)
right : (Vecp::rep(?w, ?l) ||
         Vecp::rep_ptr(?w, ?p, ?l)) at 0
left : ((w == Vecp::slot(?b, ?i)) || (Vecp::slot(?b, ?i) == w)) at 1
       wlists_rep(b, ?n, ?wm) at 2
check : infer(0 <= i);
        infer(i < 2 * n);
action : left_erase(2);
         left_add(Zlength{list{Z}}(wm) == 2 * n);
         left_add(VecpArray::full(b, 2 * n, wm));

// Expose a cell for a write without dropping the rest of its allocation.
id : 88
priority : core(2)
left : solver_int_tail(?p, ?lo, ?cap) at 0
right : (store(p + ?i * sizeof(I32), I32, ?value) ||
         undef_data_at(p + ?i * sizeof(I32), I32)) at 1
check : infer(lo <= i);
        infer(i < cap);
action : left_erase(0);
         left_exist_add(physical);
         left_add(cap <= physical);
         left_add(physical <= INT_MAX());
         left_add(vec_buf_ok(physical, p));
         left_add(IntArray::undef_seg(p, lo, physical));

