// E. User-facing 'Tag_cancel' is spelled Tagcancel by the current engine.
// Cleanup runs after core search. Successful searches consume their tags in
// core and retain freshness caches; pending tags remain to prevent restart.
// This does not erase a
// pending field request and does not turn a blocked lookup into a successful one.
id : 100
priority : Tagcancel(0)
left : field_lookup(?p : Z, ?s, ?L) at 0
action : left_erase(0);

id : 101
priority : Tagcancel(0)
right : field_lookup(?p : Z, ?s, ?L) at 0
action : right_erase(0);

// Freshness is real evidence during core search, but no longer needed after
// all resource transformations finish. Forget it only on the LEFT. There is
// deliberately no right-hand rule: a pending freshness obligation must remain.
id : 102
priority : Tagcancel(0)
left : field_fresh(?k, ?L) at 0
action : left_erase(0);


// Explicit reversed inequality: structural matching, not an SMT query.
