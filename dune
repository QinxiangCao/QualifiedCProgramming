; Generated by scripts/dune_generate.py. Refresh with:
; dune build @gen-dune-config --auto-promote
; @gen-vcs includes C programs and non-builtin strategies.

(alias (name generate) (deps (alias gen-builtin) (alias_rec gen-vcs)))
(alias (name gen-vcs) (deps (alias gen-dune-config) (alias gen-builtin)))
(alias (name gen-builtin) (deps (alias gen-builtin/export)))

(rule
 (alias gen-dune-config)
 (deps (glob_files_rec QCP_examples/*.c)
       (glob_files_rec QCP_examples/*.strategies)
       scripts/generation_tasks.py scripts/binaries.py)
 (action
  (progn
   (with-stdout-to dune.gen
    (run python3 %{dep:scripts/dune_generate.py} configure %{workspace_root}))
   (diff dune dune.gen))))

(subdir gen-rules/builtin
 (rule
  (deps ../../scripts/generation_tasks.py ../../scripts/binaries.py
        (glob_files_rec ../../bin/*))
  (action
   (with-stdout-to rules.inc
    (run python3 %{dep:../../scripts/dune_generate.py} builtin-rules %{workspace_root})))))
(subdir gen-builtin (dynamic_include ../gen-rules/builtin/rules.inc))

(subdir gen-rules
 (rule
  (targets 471.inc 932.inc 68.inc 645.inc b4.inc 579.inc 0b.inc 53.inc 18.inc 7a.inc 98.inc 78d.inc e4b.inc f5.inc 5c.inc 200.inc 39.inc ef7.inc 64f.inc b3.inc e00.inc 63.inc 260.inc 5d.inc fd.inc 5f5.inc 1f.inc a0.inc c6.inc ef4.inc a764.inc 36.inc 7b4.inc 51.inc 52.inc 74.inc 62.inc 00d.inc f1.inc fc.inc 7b1.inc 29.inc 25.inc 23.inc 576.inc 86.inc e49.inc e04.inc b7.inc 04b.inc f30.inc 1d.inc 54.inc 476.inc fa.inc 95.inc a768.inc ca.inc 090.inc 80.inc f34.inc 936.inc c9.inc c3.inc 045.inc 6c1.inc 14.inc c2.inc e1.inc 6c3.inc 16.inc 3d.inc 35.inc 091.inc e7.inc 8c.inc 27.inc 61c.inc ac.inc 9db.inc 5a.inc 00c.inc 0c.inc f8.inc 20b.inc d1.inc 48.inc 42.inc 6e.inc f3f.inc 784.inc dc.inc 73.inc c5.inc 9d3.inc c4.inc 5f2.inc 6a.inc 263.inc aa.inc 612.inc 10.inc 6c6.inc 41.inc)
  (deps (glob_files_rec ../QCP_examples/*.{c,strategies})
        ../scripts/generation_tasks.py ../scripts/binaries.py)
  (action
