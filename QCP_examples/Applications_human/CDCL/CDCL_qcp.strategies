/* --- bcp's clause-update head (rules 79/80, design ruling A9) --------------
   bcp_clause_update_state is the whole solver footprint at bcp's inner
   Assert: variable side already keyed on new_snap, row table still keyed
   on snap with row `focus` open, states split around the focused cell,
   clause summaries explicit.  Purely spatial (ruling A1): the use site
   keeps every pure fact visible.  Unfolded on BOTH sides at core(1) like
   the other heads: the head is notation, not a reasoning
   step, and a folded occurrence leaves a callee's existentials nothing to
   unify against once the caller's copy has been shredded.  Note that rule 9
   (core(0)) matches bcp_clause_scan at 0, coherent_snapshot at 1 AND
   IntArray::full(?un_ptr, live, un) at 2: the first two stay visible C
   conjuncts at the use site, but the third is inside this head and only
   reappears after 79/80 fire -- design open risk 1.
   Emitter-after-consumer: 79/80 emit the three header bundles (consumed by
   15-20), variable_arrays_rep (11/12) and installed_row_focus_rep (31/32);
   the focused int cell, IntArray::missing_i, the full/seg_shape atoms and
   PtrArray::undef_seg are leaves.  Single use; ids 81-84 stay reserved for
   the Plan-B decide wrappers. */

id : 79
priority : core(1)
right : bcp_clause_update_state(?s, ?values, ?reasons, ?levels, ?states,
          ?true_counts, ?unassigned, ?row_table, ?n, ?live, ?cap, ?dl,
          ?focus, ?row_ptr, ?current_state, ?snap, ?new_snap,
          ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : right_erase(0);
         right_exist_add(v_data);
         right_exist_add(cl_data);
         right_add(sat_header_rep(s, n, live, cap, dl, v_data, cl_data));
         right_add(var_header_rep(v_data, values, reasons, levels));
         right_add(clause_header_rep(cl_data, states, true_counts,
           unassigned, row_table));
         right_add(variable_arrays_rep(values, reasons, levels, n,
           new_snap));
         right_add(data_at(states + (focus * sizeof(I32)), I32,
           current_state));
         right_add(IntArray::missing_i(states, focus, 0, live, cur_states));
         right_add(IntArray::seg_shape(states, live, cap));
         right_add(IntArray::full(true_counts, live, cur_true));
         right_add(IntArray::seg_shape(true_counts, live, cap));
         right_add(IntArray::full(unassigned, live, cur_unassigned));
         right_add(IntArray::seg_shape(unassigned, live, cap));
         right_add(installed_row_focus_rep(row_table, live, focus, row_ptr,
           snap_rows(snap)));
         right_add(PtrArray::undef_seg(row_table, live, cap));

