priority : core(1)
left : installed_rows_capacity_rep(?p, ?live, ?cap, ?rows) at 0
right : undef_data_at(p + (live * sizeof(PTR)), PTR) at 1
check : infer(live < cap);
action : right_erase(1);
         left_erase(0);
         left_add(IntPtrArray2::full(p, live, rows));
         left_add(PtrArray::undef_seg(p, live + 1, cap));

id : 6
priority : post(1)
left : IntPtrArray2::full(?p, ?live, ?rows) at 0
       data_at(p + (live * sizeof(PTR)), PTR, ?newp) at 1
       IntArray::full(newp, Zlength{Z}(?row), row) at 2
       PtrArray::undef_seg(p, live + 1, ?cap) at 3
check : infer(0 <= live);
