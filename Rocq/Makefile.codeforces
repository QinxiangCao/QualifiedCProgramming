# Focused build for the verified Codeforces cases.
#
# Run this makefile from the repository root:
#   make -C Rocq -f Makefile.codeforces codeforces
#
# QCP symbolic execution is responsible for creating the four generated Rocq
# files listed below.  This makefile tracks and compiles those outputs; it does
# not invoke the symbolic-execution binary.

CURRENT_DIR = .
COQBIN ?=
SUF ?=

-include CONFIGURE

COQC = $(COQBIN)coqc$(SUF)
COQDEP = $(COQBIN)coqdep$(SUF)

# Keep these flags synchronized with Rocq/Makefile.
COQ_FLAG = -R flocq/src Flocq -R SeparationLogic SimpleC.SL -R unifysl Logic -R sets SetsClass -R compcert_lib compcert.lib -R auxlibs AUXLib -R examples SimpleC.EE -R stdlib SimpleC.StdLib -R StrategyLib SimpleC.StrategyLib -R Common SimpleC.Common -R fixedpoints FP -R MonadLib MonadLib -R listlib ListLib -R MaxMinLib MaxMinLib -R GraphLib GraphLib -R SumLib SumLib -R tracelib TraceLib -R coq-record-update/src RecordUpdate -Q algorithms Algorithms
DEP_FLAG = $(COQ_FLAG)

CODEFORCES_C_DIR = ../QCP_examples/LLM_bench/Codeforces
CODEFORCES_LOGICAL_HELPER_DIR = examples/LLM_bench/Codeforces
CODEFORCES_ROCQ_DIR = examples/LLM_bench/Codeforces
CODEFORCES_SHARED_STRATEGY_DIR = examples/QCP_demos_LLM

# Add a case here once; the C input, Rocq specification, and generated files
# are derived from the same canonical stem.  Both trees share the
# shard-relative stem examples_shard<NN>/P<nnn>_<contest><index>_<slug>, where
# <nnn> is the slot rank from the PV-bench SHARD<NN>.md work-list.
CODEFORCES_CASES = \
	examples_shard09/P001_1031A_golden_plate \
	examples_shard09/P002_1382A_common_subsequence \
	examples_shard09/P003_1438A_specific_tastes_of_andre \
