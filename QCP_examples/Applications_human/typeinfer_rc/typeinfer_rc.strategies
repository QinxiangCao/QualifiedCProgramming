       field_fresh(field_key(p, s), L) at 1
       q != p at 2
check : absense(field_fresh(field_key(p, s), cons{TypeFieldKey}(field_key(q, t), L)));
action : left_erase(0);
         left_add(field_fresh(field_key(p, s), cons{TypeFieldKey}(field_key(q, t), L)));

// General arithmetic fallback, reached only when faster core work is exhausted.
// Learn the actual inequality once; both descent and return then match it.
// check conditions are NOT short-circuit: priority and consumed completed tags,
// not the order of absense checks, keep ordinary cases away from this SMT query.
id : 105
priority : core(11)
left : field_lookup(?p : Z, ?s, cons{TypeFieldKey}(field_key(?q : Z, ?t), ?L)) at 0
check : absense(p != q);
        absense(q != p);
        infer(p != q);
action : left_add(p != q);
