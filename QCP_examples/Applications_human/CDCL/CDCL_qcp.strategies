action : left_erase(0);
         left_add(data_at(field_addr(s, sat_data, v_size), I32, n));
         left_add(data_at(field_addr(s, sat_data, v_data), PTR, v_data));
         left_add(data_at(field_addr(v_data, var_data, dl), PTR, levels));
