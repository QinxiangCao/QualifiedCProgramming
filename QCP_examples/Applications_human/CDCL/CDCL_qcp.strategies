/* --- clause_summaries_explicit_rep: the inner layer of rules 23/24 ---------
   Six atoms, in definition order: each of the three clause-indexed summary
   arrays as a live `full` plus its capacity `seg_shape`.  Unfolded on BOTH
   sides at core priority for the same reason as rules 11-14: the bundle is
   notation for the annotations, not a reasoning step, and a callee whose
   Require is folded has nothing left to unify its `live`/`cap` against once
   the caller's bundle has been shredded. */

id : 29
priority : core(1)
right : clause_summaries_explicit_rep(
          ?states, ?true_counts, ?unassigned, ?live, ?cap,
          ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : right_erase(0);
         right_add(IntArray::full(states, live, cur_states));
         right_add(IntArray::seg_shape(states, live, cap));
         right_add(IntArray::full(true_counts, live, cur_true));
         right_add(IntArray::seg_shape(true_counts, live, cap));
         right_add(IntArray::full(unassigned, live, cur_unassigned));
         right_add(IntArray::seg_shape(unassigned, live, cap));

id : 30
priority : core(1)
left : clause_summaries_explicit_rep(
         ?states, ?true_counts, ?unassigned, ?live, ?cap,
         ?cur_states, ?cur_true, ?cur_unassigned) at 0
action : left_erase(0);
         left_add(IntArray::full(states, live, cur_states));
         left_add(IntArray::seg_shape(states, live, cap));
         left_add(IntArray::full(true_counts, live, cur_true));
         left_add(IntArray::seg_shape(true_counts, live, cap));
         left_add(IntArray::full(unassigned, live, cur_unassigned));
         left_add(IntArray::seg_shape(unassigned, live, cap));

/* --- installed_row_focus_rep: the focused row, named ------------------------
   Three atoms, in definition order: the row-table cell holding the focused
   pointer, that row's contents, and the rest of the table.  This is the exact
   post-state of rule 3 and the exact pre-state of rule 4, so an annotation may
   now name it instead of writing the three atoms out.

   The default of the row lookup is spelled `nil{Z}` explicitly, matching
   CDCL_qcp_lib.v, rather than using the `rows[i]` shorthand: the shorthand
   introduces a universally quantified default and would make these rules need
   `0 <= i < live` to relate it back to `nil`.  These are pure definitional
   unfolds and carry no side condition. */

id : 31
priority : core(1)
right : installed_row_focus_rep(?p, ?live, ?i, ?row_ptr, ?rows) at 0
action : right_erase(0);
         right_add(data_at(p + (i * sizeof(PTR)), PTR, row_ptr));
         right_add(IntArray::full(
           row_ptr,
           Zlength{Z}(Znth{list{Z}}(i, rows, nil{Z})),
           Znth{list{Z}}(i, rows, nil{Z})));
         right_add(IntPtrArray2::missing_i(p, live, i, row_ptr, rows));

id : 32
priority : core(1)
left : installed_row_focus_rep(?p, ?live, ?i, ?row_ptr, ?rows) at 0
action : left_erase(0);
         left_add(data_at(p + (i * sizeof(PTR)), PTR, row_ptr));
         left_add(IntArray::full(
           row_ptr,
           Zlength{Z}(Znth{list{Z}}(i, rows, nil{Z})),
           Znth{list{Z}}(i, rows, nil{Z})));
         left_add(IntPtrArray2::missing_i(p, live, i, row_ptr, rows));

/* --- Public solver-contract vocabulary: the four components ----------------
   Rules 33-40 shred the four component predicates of cdcl_solver's contract.
   Each is an unconditional fixed-head core(1) pair, unfolded on BOTH sides for
   the same reason as rules 11-14: the predicates are notation for the
   contract, not a reasoning step, and a folded occurrence leaves a callee's
   `snap` existential with nothing to unify against once the caller's copy has
   been shredded.

   Components sit at lower ids than the arm cores (41-48) that emit them,
   mirroring 3-6 before 13/14: rules that consume a head come before rules that
   add it.  Composed, 41/42 -> 33-40 -> 11-22 reach exactly the atom multiset
   the unchanged body annotations already match.

   Note the argument order in the two store_cnf rules: coherent_snapshot takes
   (F, n, live, original_count, snap) while store_cnf takes original_count
   before live.  The swap is deliberate and matches CDCL_qcp_lib.v. */

id : 33
priority : core(1)
right : store_cnf(?F, ?n, ?original_count, ?states, ?true_counts,
          ?unassigned, ?row_table, ?live, ?cap, ?snap) at 0
action : right_erase(0);
         right_add(coherent_snapshot(F, n, live, original_count, snap));
         right_add(solver_arrays_rep(
           states, true_counts, unassigned, row_table, live, cap, snap));

id : 34
priority : core(1)
left : store_cnf(?F, ?n, ?original_count, ?states, ?true_counts,
         ?unassigned, ?row_table, ?live, ?cap, ?snap) at 0
action : left_erase(0);
         left_add(coherent_snapshot(F, n, live, original_count, snap));
         left_add(solver_arrays_rep(
           states, true_counts, unassigned, row_table, live, cap, snap));

id : 35
priority : core(1)
right : uninitialized_Assignment(?values, ?reasons, ?levels, ?n, ?snap) at 0
action : right_erase(0);
         right_add(all_unassigned_cells(n, snap));
         right_add(variable_arrays_rep(values, reasons, levels, n, snap));

id : 36
priority : core(1)
left : uninitialized_Assignment(?values, ?reasons, ?levels, ?n, ?snap) at 0
action : left_erase(0);
         left_add(all_unassigned_cells(n, snap));
         left_add(variable_arrays_rep(values, reasons, levels, n, snap));

id : 37
priority : core(1)
right : store_Assignment(?values, ?reasons, ?levels, ?n, ?snap, ?J) at 0
action : right_erase(0);
         right_add(J == rho_of_values(n, snap_values(snap)));
         right_add(variable_arrays_rep(values, reasons, levels, n, snap));

id : 38
priority : core(1)
left : store_Assignment(?values, ?reasons, ?levels, ?n, ?snap, ?J) at 0
action : left_erase(0);
         left_add(J == rho_of_values(n, snap_values(snap)));
         left_add(variable_arrays_rep(values, reasons, levels, n, snap));

id : 39
priority : core(1)
right : unconstrained_Assignment(?values, ?reasons, ?levels, ?n, ?snap) at 0
action : right_erase(0);
         right_add(variable_arrays_rep(values, reasons, levels, n, snap));

id : 40
priority : core(1)
left : unconstrained_Assignment(?values, ?reasons, ?levels, ?n, ?snap) at 0
action : left_erase(0);
         left_add(variable_arrays_rep(values, reasons, levels, n, snap));

/* --- Public solver-contract vocabulary: the four arm cores -----------------
   Rules 41-48 shred the entry state and the three result arms.  All fourteen
   entry ghosts stay pattern variables; only the post-state values the arm does
   not determine are existential, plus v_data/cl_data, which the C surface
   generates implicitly as fresh per-assertion variables and which a folded
   predicate has to bind explicitly.

   42 is the one regeneration hard-depends on: it turns the folded entry state
   into the atoms the first loop invariant is stated over.  The right rules
   matter less operationally -- cdcl_solver has no annotated caller, so the
   cores occur on the right only in its own return obligations, which are
   maintained-manual -- but the hygiene rule requires a matching pair for every
   C-visible predicate, so each has one. */

id : 41
priority : core(1)
right : solver_input_core(?s, ?F, ?original_count, ?snap, ?ranks, ?values,
          ?reasons, ?levels, ?states, ?true_counts, ?unassigned, ?row_table,
          ?n, ?live, ?cap) at 0
action : right_erase(0);
