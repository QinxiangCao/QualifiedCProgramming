// Focus a readable/writable double cell from a live segment.
id : 12
priority : core(1)
left : DoubleArray::seg(?p, ?lo, ?hi, ?l) at 0
right : store(?p + (?i * sizeof(double)), double, ?v) at 1
check : infer(lo <= i);
        infer(i < hi);
action : right_erase(1);
         left_erase(0);
         left_add(DoubleArray::missing_i(p, i, lo, hi, l));
         right_add(v == double_Znth(i - lo, l));

// Refold a double segment after a read that leaves the focused value intact.
id : 13
priority : post(1)
left : DoubleArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(p + i * sizeof(double), double, double_Znth(i - lo, l)) at 1
check : infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(DoubleArray::seg(p, lo, hi, l));

// Refold a double segment after updating the focused cell.
id : 14
priority : post(4)
left : DoubleArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(p + i * sizeof(double), double, ?v) at 1
check : infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(DoubleArray::seg(
           p, lo, hi, replace_Znth{fp64}(i - lo, v, l)));

// Refold enqueue's narrow state while preserving the cached assignment and
// level backing addresses across the call boundary.
id : 16
priority : core(2)
right : enqueue_state_at(?s, ?asg, ?lvl, ?n, ?cap, ?qtail,
                         ?assigns, ?levels, ?reasons, ?trail,
                         ?lim, ?lim_cap) at 0
left : (store(field_addr(s, solver_t, qtail), I32, ?y) ||
        store(field_addr(s, solver_t, assigns), PTR, ?y) ||
        store(field_addr(s, solver_t, levels), PTR, ?y) ||
        store(field_addr(s, solver_t, reasons), PTR, ?y) ||
        store(field_addr(s, solver_t, trail), PTR, ?y)) at 1
action : right_erase(0);
         right_exist_add(rsn);
         right_exist_add(trl);
         right_add(0 <= n);
         right_add(n <= cap);
         right_add(cap <= INT_MAX());
         right_add(Zlength{Z}(assigns) == n);
         right_add(Zlength{Z}(levels) == n);
         right_add(Zlength{Z}(reasons) == n);
         right_add(Zlength{Z}(trail) == qtail);
         right_add(0 <= qtail);
         right_add(qtail <= cap);
         right_add(store(field_addr(s, solver_t, qtail), I32, qtail));
         right_add(store(field_addr(s, solver_t, assigns), PTR, asg));
         right_add(store(field_addr(s, solver_t, levels), PTR, lvl));
         right_add(store(field_addr(s, solver_t, reasons), PTR, rsn));
         right_add(store(field_addr(s, solver_t, trail), PTR, trl));
         right_add(CharArray::seg(asg, 0, n, assigns));
         right_add(CharArray::undef_seg(asg, n, cap));
         right_add(IntArray::seg(lvl, 0, n, levels));
         right_add(IntArray::undef_seg(lvl, n, cap));
         right_add(PtrArray::seg(rsn, 0, n, reasons));
         right_add(PtrArray::undef_seg(rsn, n, cap));
         right_add(IntArray::seg(trl, 0, qtail, trail));
         right_add(IntArray::undef_seg(trl, qtail, cap));
         right_add(veci_rep(field_addr(s, solver_t, trail_lim), lim, lim_cap));

// Heap projection changes only heap metadata, so the framed level slice can
// be reindexed before the nested cancellation call.
id : 23
priority : core(2)
left : solver_levels_slice_at(?s, ?M, ?lvl) at 0
right : solver_levels_slice_at(
          s, msolver_heap_project(M, ?orderpos, ?order, ?order_cap), lvl) at 1
action : left_erase(0);
         right_erase(1);

// Close the opaque reason-array hole only when the caller explicitly asks for
// the original segment.  The concrete load index is matched spatially first;
// the equality check then connects it to the logical focused index.
id : 29
priority : core(2)
left : removable_reason_array_hole(?p, ?i, ?n, ?words) at 0
       store(pointer_offset(p, ?j, PTR), PTR,
             Znth{Z}(i, words, 0)) at 1
right : PtrArray::seg(p, 0, n, words) at 2
check : infer(0 <= i);
        infer(i < n);
        infer(i == j);
action : left_erase(1);
         left_erase(0);
         right_erase(2);

// Open the header-safe count cell only when its concrete size field is needed.
id : 33
priority : core(2)
left : solver_clause_count_cell(?s, ?n) at 0
right : store(field_addr(field_addr(s, solver_t, clauses), vecp_t, size),
              I32, ?value) at 1
action : left_erase(0);
         left_add(store(field_addr(field_addr(s, solver_t, clauses), vecp_t, size),
                        I32, n));

// Expose a requested count cell; existing vector rules preserve the caller frame.
id : 34
priority : core(2)
right : solver_clause_count_cell(?s, ?n) at 0
left : (store(field_addr(field_addr(s, solver_t, clauses), vecp_t, size),
              I32, ?value) ||
        vecp_rep(field_addr(s, solver_t, clauses), ?words, ?cap)) at 1
action : right_erase(0);
         right_add(store(field_addr(field_addr(s, solver_t, clauses), vecp_t, size),
                         I32, n));

// vecp_resize's nested size read leaves the vector in raw field form with a
// temporary cut expression.  Reclose only an explicitly requested prefix
// representation under the inferred cut equality.
id : 35
priority : core(1)
left : store(
         field_addr(?raw_v, vecp_t, size), I32,
         Zlength{Z}(sublist{Z}(0, ?actual_cut, ?words))) at 0
       store(field_addr(raw_v, vecp_t, cap), I32, ?cap) at 1
       store(field_addr(raw_v, vecp_t, ptr), PTR, ?p) at 2
       PtrArray::seg(
         p, 0, Zlength{Z}(sublist{Z}(0, actual_cut, words)),
         sublist{Z}(0, actual_cut, words)) at 3
       PtrArray::undef_seg(
         p, Zlength{Z}(sublist{Z}(0, actual_cut, words)), cap) at 4
right : vecp_rep(
          ?closed_v, sublist{Z}(0, ?required_cut, words), cap) at 5
check : infer(raw_v == closed_v);
        infer(actual_cut == required_cut);
        infer(0 <= Zlength{Z}(sublist{Z}(0, actual_cut, words)));
        infer(Zlength{Z}(sublist{Z}(0, actual_cut, words)) <= cap);
        infer(0 < cap);
        infer(cap <= INT_MAX());
action : left_erase(4);
         left_erase(3);
         left_erase(2);
         left_erase(1);
         left_erase(0);
         right_erase(5);

// Focus the base cell of an integer segment for an UNINDEXED write (`*p = v`).
// The shared int_array rule 7 matches only an offset-shaped address
// (`p + i * sizeof(I32)`), so a bare base-pointer store finds no rule; this is
// needed by the 1-UIP head overwrite `*veci_begin(learnt) = lit_neg(p)`.
id : 36
priority : core(1)
left : IntArray::seg(?p, ?lo, ?hi, ?l) at 0
right : store(p, I32, ?v) at 1
check : infer(lo <= 0);
        infer(0 < hi);
action : right_erase(1);
         left_erase(0);
         left_add(IntArray::missing_i(p, 0, lo, hi, l));
         right_add(v == l[0 - lo]);

// Bare-base alias returned by a getter: require its explicit equality first.
// This is the equality-gated store bridge used by common rule 11, with the
// integer base-cell focus. It also handles the learned clause's 1-UIP write.
id : 69
priority : core(1)
left : IntArray::seg(?p, ?lo, ?hi, ?l) at 0
       (p == ?q) || (?q == p) at 1
right : store(q, I32, ?v) at 2
check : infer(lo <= 0);
        infer(0 < hi);
action : right_erase(2);
         left_erase(0);
         left_add(IntArray::missing_i(p, 0, lo, hi, l));
         right_add(v == l[0 - lo]);

// int_array rule 7 matches only the `?p + ?i * sizeof(I32)` spelling.  A write
// through a returned pointer (clause_begin(c))[1] is emitted as
// pointer_offset, so the focus/refold pair has to be restated for it -- the
// same reason ids 26/27 exist for the Char and Ptr arrays.
id : 37
priority : core(1)
left : IntArray::seg(?p, ?lo, ?hi, ?l) at 0
right : store(pointer_offset(?q, ?i, I32), I32, ?v) at 1
check : infer(q == p);
        infer(lo <= i);
        infer(i < hi);
action : right_erase(1);
         left_erase(0);
         left_add(IntArray::missing_i(p, i, lo, hi, l));
         right_add(v == l[i - lo]);

// Reclose a pointer_offset integer focus after a read of the existing value.
// This is the IntArray counterpart of rule 57 and must run before the
// updating refold below, which intentionally materializes replace_Znth.
id : 67
priority : post(1)
left : IntArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I32), I32, l[i - lo]) at 1
check : infer(q == p);
        infer(i == j);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(IntArray::seg(p, lo, hi, l));

// Refold the focused integer cell after the write.
id : 38
priority : post(5)
left : IntArray::missing_i(?p, ?i, ?lo, ?hi, ?l) at 0
       store(pointer_offset(?q, ?j, I32), I32, ?v) at 1
check : infer(q == p);
        infer(lo <= i);
        infer(i < hi);
        infer(i == j);
action : left_erase(1);
         left_erase(0);
         left_add(IntArray::seg(
           p, lo, hi, replace_Znth{Z}(i - lo, v, l)));

// clause_cmp's aliased arm (x == y) owns ONE learned object but reads it
// through both comparator parameters, and the body is a single return
// expression, so there is no annotation point between the reads at which to
// re-spell the focus.  Bridge the two spellings of the same address under the
// inferred pointer equality, the way rule 37 bridges `q` and `p`.  The
// remainder atom gates the rule to that arm; it is a trigger only and is not
// erased (cf. rules 3/5/7/9/16).
// Obligation: from xp == yp, store(clause_hdr_addr(xp), I32, w) entails
// EX v, store(clause_hdr_addr(yp), I32, v) && v == w  (witness v := w).
id : 39
priority : core(1)
left : store(clause_hdr_addr(?xp), I32, ?w) at 0
       learnt_sort_alias_remainder(?db, ?activities, ?xr, ?xw, ?xa) at 1
right : store(clause_hdr_addr(?yp), I32, ?v) at 2
check : infer(xp == yp);
        infer(xp == xr);
action : left_erase(0);
         right_erase(2);
         right_add(v == w);

// Same bridge for the activity cell read by clause_activity in that arm.
id : 40
priority : core(1)
left : store(clause_act_addr(?xp), float, ?a) at 0
       learnt_sort_alias_remainder(?db, ?activities, ?xr, ?xw, ?xa) at 1
right : store(clause_act_addr(?yp), float, ?b) at 2
check : infer(xp == yp);
        infer(xp == xr);
action : left_erase(0);
         right_erase(2);
         right_add(b == a);

// `*clause_begin(c)` reads a clause's first literal through the pointer that
// clause_begin returned.  clause_begin's Ensure is
// `__return == clause_lits_addr(c) && emp`: it does NOT carry the heap (unlike
// veci_begin / vecp_begin, whose Ensure re-keys the payload to `__return`), so the
// literal array stays keyed on `clause_lits_addr(c)` while the read address is the
// unnameable `__return`.  Rule 36 needs syntactic identity of the base; rule 37
// bridges `infer(q == p)` only for the `pointer_offset` spelling.  Rules 41/42 are
// the missing bare-base + infer member of that family.
//
// Re-keying clause_begin's Ensure to `__return` instead (the veci_begin idiom) is
// not an option: it strengthens a Require that four other call sites cannot
// meet (clause_simplify and solver_simplify hold the array folded inside
// MiniSatClause::rep; solver_propagate holds it keyed on a ghost base in one
// block and as IntArray::full in another), and it leaves the array keyed on an
// unnameable retval that no annotation can name afterwards.
//
// GATING.  The focused segment must literally be a CLAUSE LITERAL ARRAY --
// `IntArray::seg(clause_lits_addr(?cp), ...)`.  Every other integer array in this
// development (trail, levels, order, orderpos, tagged, stack, trail_lim and every
// veci payload) is keyed on a plain pointer or a `field_addr`, so these rules
// cannot see them at all.  The second gate, `infer(q == clause_lits_addr(cp))`, is
// discharged only by a `clause_begin` Ensure.  Sites reached: the three
// `*clause_begin(...)` reads, two in solver_reducedb and one in solver_simplify.
id : 41
priority : core(1)
left : IntArray::seg(clause_lits_addr(?cp), ?lo, ?hi, ?l) at 0
right : store(?q, I32, ?v) at 1
check : infer(q == clause_lits_addr(cp));
        infer(lo <= 0);
        infer(0 < hi);
action : right_erase(1);
         left_erase(0);
         left_add(IntArray::missing_i(clause_lits_addr(cp), 0, lo, hi, l));
         right_add(v == l[0 - lo]);

// Reclose the focus rule 41 opened, once the read has evaluated.  Same clause-array
// gate; `infer(i == 0)` confines it to the base cell that rule 41 focuses.  The
// stored value is required to be SYNTACTICALLY the focused element, so this is the
// read-only refold (int_array rule 11's shape, not rule 12's): the segment comes
// back as `l`, not as `replace_Znth(i - lo, v, l)`.  That matters -- the
// replace_Znth spelling leaves `replace_Znth(0, l[0], l) == l` as an
// undischargeable PROP obligation in clause_simplify's callee Require, where a
// pure Require is a hard stop and `replace_Znth` is opaque to `infer`.
id : 42
priority : post(1)
left : IntArray::missing_i(clause_lits_addr(?cp), ?i, ?lo, ?hi, ?l) at 0
       store(?q, I32, l[i - lo]) at 1
check : infer(q == clause_lits_addr(cp));
        infer(i == 0);
        infer(lo <= i);
        infer(i < hi);
action : left_erase(1);
         left_erase(0);
         left_add(IntArray::seg(clause_lits_addr(cp), lo, hi, l));

// Expose root control while preserving the watcher-table address.
id : 43
priority : core(2)
right : solver_search_root_frame_at(?s, ?M, ?lvl, ?wl) at 0
left : solver_rep_levels_wl_at(s, M, wl, lvl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(s, solver_t, root_level), I32,
                        ms_root_level(M)));
         left_add(veci_rep(field_addr(s, solver_t, trail_lim),
                           mt_lim(ms_core(M)), ms_lim_cap(M)));

// Rejoin root control with the same watcher-table address.
id : 44
priority : core(2)
right : solver_rep_levels_wl_at(?s, ?M, ?wl, ?lvl) at 0
left : solver_search_root_frame_at(s, M, lvl, wl) at 1
       store(field_addr(s, solver_t, root_level), I32, ms_root_level(M)) at 2
       veci_rep(field_addr(s, solver_t, trail_lim),
                mt_lim(ms_core(M)), ms_lim_cap(M)) at 3
action : right_erase(0);
         left_erase(3);
         left_erase(2);
         left_erase(1);

// Expose root control and the level slice, retaining the watcher table.
id : 45
priority : core(2)
right : solver_search_root_payload(?s, ?M, ?wl) at 0
left : solver_rep_levels_wl_at(s, M, wl, ?lvl) at 1
action : right_erase(0);
         left_erase(1);
         left_add(store(field_addr(s, solver_t, root_level), I32,
                        ms_root_level(M)));
         left_add(veci_rep(field_addr(s, solver_t, trail_lim),
