check : infer(base < cursor);
        infer(index <= hi);
action : left_erase(0);
         right_erase(2);
         left_add(0 < index);
         left_add(IntArray::missing_i(base, index - 1, 0, hi, arr));
         right_add(value == arr[index - 1]);

