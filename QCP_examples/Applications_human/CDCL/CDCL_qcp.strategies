action : right_erase(0);
         right_exist_add(v_data);
         right_exist_add(cl_data);
         right_add(0 < n);
         right_add(n < INT_MAX());
         right_add(0 <= original_count);
         right_add(original_count <= live);
         right_add(0 <= live);
         right_add(live <= cap);
         right_add(0 < logical_dl);
         right_add(0 <= focus);
         right_add(focus < live);
         right_add(coherent_snapshot(F, n, live, original_count, snap));
         right_add(stable_search_facts(n, snap, ranks, logical_dl));
         right_add(sat_header_rep(
           s, n, live, cap, logical_dl, v_data, cl_data));
