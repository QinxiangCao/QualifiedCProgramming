// Refold the exposed pointer-vector representation on the spatial right.
id : 9
priority : core(2)
right : vecp_rep_at(?v, ?p, ?l, ?cap) at 0
left : (store(field_addr(v, vecp_t, size), I32, ?y) ||
        store(field_addr(v, vecp_t, cap), I32, ?y) ||
