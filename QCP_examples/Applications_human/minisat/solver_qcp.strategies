         left_add(store(field_addr(s, solver_t, activity), PTR, act));
         left_add(store(field_addr(s, solver_t, assigns), PTR, asg));
         left_add(store(field_addr(s, solver_t, orderpos), PTR, opos));
         left_add(store(field_addr(s, solver_t, reasons), PTR, rsn));
         left_add(store(field_addr(s, solver_t, trail), PTR, trl));
         left_add(DoubleArray::seg(act, 0, ms_size(M), ms_activity(M)));
         left_add(CharArray::seg(asg, 0, ms_size(M), asg_l));
         left_add(IntArray::seg(opos, 0, ms_size(M), opos_l));
         left_add(PtrArray::seg(rsn, 0, ms_size(M), rsn_l));
         left_add(IntArray::seg(trl, 0, ms_qtail(M), mt_trail(ms_core(M))));
         left_add(solver_cancel_undef_tail(M, act, asg, opos, rsn, trl));
         left_add(veci_rep(field_addr(s, solver_t, order), ord_l, ord_cap));
         left_add(veci_rep(field_addr(s, solver_t, trail_lim), mt_lim(ms_core(M)), ms_lim_cap(M)));
         left_add(solver_cancel_frame(s, M, wl));

// Demand-driven unfold of the clause-removal working view.
// `clause_remove_open_at` is `clause_remove_pre`'s spatial part with the
// clause object lifted out: the solver cells clause_remove keeps between its
// entry unfold and its cut after `clause_begin`.  Any right-side demand for
// the size cell (the range asserts), the watcher table (the focus steps and
// `solver_read_wlist`), a statistics counter (the four decrements) or the
// reasons array opens it in place; it is re-formed only by Coq at the entry
// cut, never on the spatial right.
// SCOPING: the name occurs on the entry which-implies RHS and the following
//   `Assert` inside `clause_remove` only; ZERO Require/Ensure.
//   Left-only unfold, no check.
// ENV: every action symbol is declared in solver_qcp_def.h (stats_rep's
//   eleven cells are re-emitted raw, in the spelling the ambient state uses).
// OBLIGATION: solver_qcp_strategy65 (unfold + stats_rep open + cancel).
id : 65
priority : core(2)
left : clause_remove_open_at(?s, ?n, ?cap, ?wl, ?rsn, ?wm, ?caps, ?stats0, ?reasons0) at 0
right : (store(field_addr(s, solver_t, size), I32, ?y) ||
         store(field_addr(s, solver_t, reasons), PTR, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, starts), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, decisions), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, propagations), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, inspects), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, conflicts), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, clauses), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, clauses_literals), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, learnts), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, learnts_literals), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, max_literals), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, tot_literals), U64, ?y) ||
         wlists_rep(wl, ?wn, ?wmd, ?wcd) ||
         PtrArray::seg(rsn, ?lo, ?hi, ?l) ||
         PtrArray::undef_seg(rsn, ?lo, ?hi) ||
         store(pointer_offset(rsn, ?i, PTR), PTR, ?y)) at 1
action : left_erase(0);
         left_add(store(field_addr(s, solver_t, size), I32, n));
         left_add(store(field_addr(s, solver_t, reasons), PTR, rsn));
         left_add(PtrArray::seg(rsn, 0, n, reasons0));
         left_add(PtrArray::undef_seg(rsn, n, cap));
         left_add(solver_wlists_handle(s, wl));
         left_add(wlists_rep(wl, n, wm, caps));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, starts),
                        U64, stats_starts(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, decisions),
                        U64, stats_decisions(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, propagations),
                        U64, stats_propagations(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, inspects),
                        U64, stats_inspects(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, conflicts),
                        U64, stats_conflicts(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, clauses),
                        U64, stats_clauses(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, clauses_literals),
                        U64, stats_clauses_literals(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, learnts),
                        U64, stats_learnts(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, learnts_literals),
                        U64, stats_learnts_literals(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, max_literals),
                        U64, stats_max_literals(stats0)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, tot_literals),
                        U64, stats_tot_literals(stats0)));

// Demand-driven unfold of the propagation working view.
// `solver_propagate_open_at` is `solver_propagate_pre`'s spatial part with
// the two clause databases, the binary scratch clause and the conflict
// out-parameter lifted out: the state `solver_propagate` carries at its entry
// unfold and at the head of its outer loop.  The loop condition reads
// `s->qtail` and `s->qhead`, so the bundle opens at every iteration head and
// the body's cuts see raw atoms; it is re-formed only by Coq at the loop
// invariant.  Any right-side demand for one of its nine field cells, a live
// or undefined array segment, the trail-limit vector, the watcher table, one
// of the two statistics counters, or an array cell reached through the
// cached local pointers (`values[..]`, `reasons[..]`, `levels[..]`,
// `trail[..]`) opens it in place.
// SCOPING: the name occurs on the entry which-implies RHS and in the outer
//   `Inv Assert` inside `solver_propagate` only; ZERO Require/Ensure.
//   Left-only unfold, no check.
// ENV: every action symbol is declared in solver_qcp_def.h.
// OBLIGATION: solver_qcp_strategy66 (unfold + cancel).
id : 66
priority : core(2)
left : solver_propagate_open_at(?s, ?M, ?wl, ?asg, ?rsn, ?lvl, ?trl) at 0
right : (store(field_addr(s, solver_t, qhead), I32, ?y) ||
         store(field_addr(s, solver_t, qtail), I32, ?y) ||
         store(field_addr(s, solver_t, simpdb_props), I32, ?y) ||
         store(field_addr(s, solver_t, wlists), PTR, ?y) ||
         store(field_addr(s, solver_t, assigns), PTR, ?y) ||
         store(field_addr(s, solver_t, reasons), PTR, ?y) ||
         store(field_addr(s, solver_t, levels), PTR, ?y) ||
         store(field_addr(s, solver_t, trail), PTR, ?y) ||
         store(field_addr(s, solver_t, binary), PTR, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, propagations), U64, ?y) ||
         store(field_addr(field_addr(s, solver_t, stats), stats_t, inspects), U64, ?y) ||
         veci_rep(field_addr(s, solver_t, trail_lim), ?l, ?c) ||
         wlists_rep(wl, ?wn, ?wmd, ?wcd) ||
         CharArray::seg(asg, ?lo, ?hi, ?l) ||
         CharArray::undef_seg(asg, ?lo, ?hi) ||
         PtrArray::seg(rsn, ?lo, ?hi, ?l) ||
         PtrArray::undef_seg(rsn, ?lo, ?hi) ||
         IntArray::seg(lvl, ?lo, ?hi, ?l) ||
         IntArray::undef_seg(lvl, ?lo, ?hi) ||
         IntArray::seg(trl, ?lo, ?hi, ?l) ||
         IntArray::undef_seg(trl, ?lo, ?hi) ||
         store(pointer_offset(asg, ?i, I8), I8, ?y) ||
         store(pointer_offset(rsn, ?i, PTR), PTR, ?y) ||
         store(pointer_offset(lvl, ?i, I32), I32, ?y) ||
         store(pointer_offset(trl, ?i, I32), I32, ?y)) at 1
action : left_erase(0);
         left_add(store(field_addr(s, solver_t, qhead), I32, mt_qhead(ms_core(M))));
         left_add(store(field_addr(s, solver_t, qtail), I32, ms_qtail(M)));
         left_add(store(field_addr(s, solver_t, simpdb_props), I32, ms_simpdb_props(M)));
         left_add(store(field_addr(s, solver_t, wlists), PTR, wl));
         left_add(store(field_addr(s, solver_t, assigns), PTR, asg));
         left_add(store(field_addr(s, solver_t, reasons), PTR, rsn));
         left_add(store(field_addr(s, solver_t, levels), PTR, lvl));
         left_add(store(field_addr(s, solver_t, trail), PTR, trl));
         left_add(store(field_addr(s, solver_t, binary), PTR, ms_binary(M)));
         left_add(CharArray::seg(asg, 0, ms_size(M), mt_assigns(ms_core(M))));
         left_add(CharArray::undef_seg(asg, ms_size(M), ms_cap(M)));
         left_add(PtrArray::seg(rsn, 0, ms_size(M), ms_reason_words(M)));
         left_add(PtrArray::undef_seg(rsn, ms_size(M), ms_cap(M)));
         left_add(IntArray::seg(lvl, 0, ms_size(M), mt_levels(ms_core(M))));
         left_add(IntArray::undef_seg(lvl, ms_size(M), ms_cap(M)));
         left_add(IntArray::seg(trl, 0, ms_qtail(M), mt_trail(ms_core(M))));
         left_add(IntArray::undef_seg(trl, ms_qtail(M), ms_cap(M)));
         left_add(veci_rep(field_addr(s, solver_t, trail_lim), mt_lim(ms_core(M)), ms_lim_cap(M)));
         left_add(wlists_rep(wl, ms_size(M), ms_wm(M), ms_wcaps(M)));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, propagations),
                        U64, stats_propagations(ms_stats(M))));
         left_add(store(field_addr(field_addr(s, solver_t, stats), stats_t, inspects),
                        U64, stats_inspects(ms_stats(M))));
         left_add(solver_propagate_frame(s, M));
