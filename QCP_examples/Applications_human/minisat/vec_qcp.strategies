// Veci::rep_ptr on the right and the opened fields on the left, with its element segment and its
// undefined tail keyed on the size-cell value n (after an in-place element write the list changed but the
// length expression did not): close it, asking n == Zlength(l), the bounds and the buffer validity.
id : 209
priority : core(1)
right : Veci::rep_ptr(?v, ?p, ?l) at 0
left : store(field_addr(v, veci_t, size), I32, ?n) at 1
       store(field_addr(v, veci_t, cap), I32, ?cap) at 2
       store(field_addr(v, veci_t, ptr), PTR, ?q) at 3
       IntArray::seg(q, 0, n, ?k) at 4
       IntArray::undef_seg(q, n, cap) at 5
action : right_erase(0);
         left_erase(5);
         left_erase(4);
         left_erase(3);
         left_erase(2);
         left_erase(1);
         right_add(q == p);
         right_add(k == l);
         right_add(n == Zlength{Z}(l));
         right_add(0 <= n);
         right_add(n <= cap);
         right_add(cap <= INT_MAX());
         right_add(vec_buf_ok(cap, q));

// Veci::rep_ptr on the right and the opened fields on the left, with its elements as a full array and its
// undefined tail keyed on the size-cell value n (after an in-place element write the list changed but the
// length expression did not): close it, asking n == Zlength(l), the bounds and the buffer validity.
id : 210
priority : core(1)
right : Veci::rep_ptr(?v, ?p, ?l) at 0
left : store(field_addr(v, veci_t, size), I32, ?n) at 1
       store(field_addr(v, veci_t, cap), I32, ?cap) at 2
       store(field_addr(v, veci_t, ptr), PTR, ?q) at 3
       IntArray::full(q, n, ?k) at 4
       IntArray::undef_seg(q, n, cap) at 5
action : right_erase(0);
         left_erase(5);
         left_erase(4);
         left_erase(3);
         left_erase(2);
         left_erase(1);
         right_add(q == p);
         right_add(k == l);
         right_add(n == Zlength{Z}(l));
         right_add(0 <= n);
