       store(field_addr(v, vecp_t, cap), I32, ?cap) at 2
       store(field_addr(v, vecp_t, ptr), PTR, ?q) at 3
       PtrArray::seg(q, 0, n, ?k) at 4
       PtrArray::undef_seg(q, n, cap) at 5
action : right_erase(0);
         left_erase(5);
         left_erase(4);
         left_erase(3);
         left_erase(2);
         left_erase(1);
         right_add(q == p);
         right_add(k == l);
         right_add(n == Zlength{Z}(l));
