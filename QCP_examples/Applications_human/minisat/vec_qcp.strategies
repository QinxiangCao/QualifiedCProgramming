// QCP names an uninitialized local veci_t UndefStructPredveci_t: the same cells as Veci::shell.
id : 9
priority : core(2)
left : UndefStructPredveci_t(?v) at 0
right : Veci::shell(v) at 1
action : left_erase(0);
         right_erase(1);

id : 10
priority : core(2)
right : UndefStructPredveci_t(?v) at 0
left : Veci::shell(v) at 1
action : right_erase(0);
         left_erase(1);

