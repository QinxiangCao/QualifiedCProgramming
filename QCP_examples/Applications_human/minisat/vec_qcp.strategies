id : 205
priority : core(2)
right : Veci::rep_ptr(?v, ?p, ?l) at 0
left : Veci::rep_ptr(?w, ?q, ?k) at 1
check : infer(w == v);
action : right_erase(0);
         left_erase(1);
         right_add(q == p);
         right_add(k == l);

