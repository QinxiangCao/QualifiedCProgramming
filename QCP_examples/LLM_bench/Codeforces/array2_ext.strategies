right : data_at(pointer_offset(?p, ((?i * ?m) + ?j), I32), I32, ?v) at 1
check : infer(0 <= i);
        infer(i < n);
        infer(0 <= j);
        infer(j < m);
action : right_erase(1);
         left_erase(0);
         left_add(IntArray2::mixed_missing_i(p, i, 0, n, m, rows));
         left_add(IntArray::mixed_missing_i(pointer_offset(p, (i * m), I32), j, 0, m, rows[i]));
