right : solver_arrays_rep(?st, ?tc, ?un, ?rt, ?live, ?cap, ?snap) at 0
action : right_erase(0);
         right_add(IntArray::seg(st, 0, live, snap_states(snap)));
         right_add(IntArray::seg_shape(st, live, cap));
         right_add(IntArray::seg(tc, 0, live, snap_true_counts(snap)));
         right_add(IntArray::seg_shape(tc, live, cap));
         right_add(IntArray::seg(un, 0, live, snap_unassigned(snap)));
         right_add(IntArray::seg_shape(un, live, cap));
         right_add(installed_rows_capacity_rep(rt, live, cap, snap_rows(snap)));

