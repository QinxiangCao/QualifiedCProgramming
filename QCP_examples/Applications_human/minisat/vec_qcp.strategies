// Strategies of the vectors of vec_qcp.h: Veci (int elements) and Vecp (pointer elements), both
// instances of DynVec (dynvec_lib.v, vec_qcp_lib.v).  Nothing here mentions the solver: a program
// that includes vec_qcp.h gets these rules and their proofs (vec_qcp_strategy_proof.v).
//
// Opening a vector for a field access (only the vector unit's own bodies make one) yields its three
// fields; opening it for a buffer access yields Veci::header / Vecp::header, which keeps the fields
// packed.  Both also yield the element segment, the undefined tail and the facts
// 0 <= |l| <= cap <= INT_MAX and vec_buf_ok(cap, p) (a vector without capacity stores NULL);
// closing asks for the same facts.
//
// A table of Vecp vectors (VecpArray) gives out one vector at a time and takes it back (rules
// 401-409 and 411-416); rules 60 and 68 cancel IntArray / PtrArray segments whose bases are
// provably equal (rule 68 also matches the bounds up to provable equality).

#include "vec_qcp_def.h"

// Veci::rep on the left and a field on the right: open it.
id : 2
priority : core(2)
left : Veci::rep(?v, ?l) at 0
right : (store(field_addr(v, veci_t, size), I32, ?y) ||
         store(field_addr(v, veci_t, cap), I32, ?y) ||
         store(field_addr(v, veci_t, ptr), PTR, ?y)) at 1
action : left_erase(0);
         left_exist_add(p);
         left_exist_add(cap);
         left_add(0 <= Zlength{Z}(l));
         left_add(Zlength{Z}(l) <= cap);
         left_add(cap <= INT_MAX());
         left_add(vec_buf_ok(cap, p));
         left_add(store(field_addr(v, veci_t, size), I32, Zlength{Z}(l)));
         left_add(store(field_addr(v, veci_t, cap), I32, cap));
         left_add(store(field_addr(v, veci_t, ptr), PTR, p));
         left_add(IntArray::seg(p, 0, Zlength{Z}(l), l));
         left_add(IntArray::undef_seg(p, Zlength{Z}(l), cap));

// Veci::rep on the right and the fields on the left: close it.
id : 5
priority : core(2)
right : Veci::rep(?v, ?l) at 0
left : (store(field_addr(v, veci_t, size), I32, ?y) ||
         store(field_addr(v, veci_t, cap), I32, ?y) ||
         store(field_addr(v, veci_t, ptr), PTR, ?y)) at 1
action : right_erase(0);
         right_exist_add(p);
         right_exist_add(cap);
         right_add(0 <= Zlength{Z}(l));
         right_add(Zlength{Z}(l) <= cap);
         right_add(cap <= INT_MAX());
         right_add(vec_buf_ok(cap, p));
         right_add(store(field_addr(v, veci_t, size), I32, Zlength{Z}(l)));
         right_add(store(field_addr(v, veci_t, cap), I32, cap));
         right_add(store(field_addr(v, veci_t, ptr), PTR, p));
         right_add(IntArray::seg(p, 0, Zlength{Z}(l), l));
         right_add(IntArray::undef_seg(p, Zlength{Z}(l), cap));

// Veci::shell on the left and a field on the right: expose the three fields.
id : 7
priority : core(2)
left : Veci::shell(?v) at 0
right : (store(field_addr(v, veci_t, size), I32, ?y) ||
         undef_data_at(field_addr(v, veci_t, size), I32) ||
         store(field_addr(v, veci_t, cap), I32, ?y) ||
         undef_data_at(field_addr(v, veci_t, cap), I32) ||
         store(field_addr(v, veci_t, ptr), PTR, ?y) ||
         undef_data_at(field_addr(v, veci_t, ptr), PTR)) at 1
action : left_erase(0);
         left_add(undef_data_at(field_addr(v, veci_t, size), I32));
         left_add(undef_data_at(field_addr(v, veci_t, cap), I32));
         left_add(undef_data_at(field_addr(v, veci_t, ptr), PTR));

// Veci::shell on the right and a field on the left: collect the three fields.
id : 8
priority : core(2)
right : Veci::shell(?v) at 0
left : (store(field_addr(v, veci_t, size), I32, ?y) ||
         undef_data_at(field_addr(v, veci_t, size), I32) ||
         store(field_addr(v, veci_t, cap), I32, ?y) ||
         undef_data_at(field_addr(v, veci_t, cap), I32) ||
         store(field_addr(v, veci_t, ptr), PTR, ?y) ||
         undef_data_at(field_addr(v, veci_t, ptr), PTR)) at 1
action : right_erase(0);
         right_add(undef_data_at(field_addr(v, veci_t, size), I32));
         right_add(undef_data_at(field_addr(v, veci_t, cap), I32));
         right_add(undef_data_at(field_addr(v, veci_t, ptr), PTR));

